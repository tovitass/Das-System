{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch core.json and rebuild core.js",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/Das System/watch_core.py"],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "core-json-builder",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Watching core.json.*",
          "endsPattern": ".*Rebuilt core.js from core.json.*"
        }
      }
    }
  ]
}
